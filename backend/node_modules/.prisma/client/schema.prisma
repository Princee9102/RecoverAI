datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id                      String   @id @default(uuid())
  transaction_id          String   @unique
  customer_id             String
  customer_name           String   @default("Razorpay Customer")
  customer_email          String   @default("customer@example.com")
  amount                  Float
  currency                String   @default("INR")
  payment_method          String
  failure_reason          String
  attempt_number          Int      @default(1)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  customer_segment        String
  subscription_status     String
  previous_success_rate   Float
  days_since_last_payment Int      @default(30)
  invoice_status          String
  risk_score              Float
  risk_level              String   @default("medium")
  recovery_status         String   @default("at_risk")
  recovery_action         String?
  ai_diagnosis            String?
  ai_explanation          String?
  ai_confidence           Float?
  recovered_amount        Float    @default(0.0)
  recovery_attempts       Int      @default(0)
  communication_attempts  Int      @default(0)

  recovery_actions RecoveryAction[]
  audit_logs       AuditLog[]
}

model RecoveryAction {
  id               String      @id @default(uuid())
  transaction_id   String
  action_type      String
  status           String
  attempt_number   Int
  executed_at      DateTime    @default(now())
  gateway_response String?
  error_message    String?
  transaction      Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)
}

model AuditLog {
  id             String      @id @default(uuid())
  timestamp      DateTime    @default(now())
  transaction_id String
  event_type     String
  decision       String
  reason         String
  confidence     Float
  action         String
  result         String
  transaction    Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade)
}

model SimulationRun {
  id                String   @id @default(uuid())
  run_at            DateTime @default(now())
  total_processed   Int
  recoverable_count Int
  recovered_count   Int
  recovered_amount  Float
  recovery_rate     Float
  escalation_count  Int
  duration_ms       Int
}

model SafetyRule {
  id          String   @id @default(uuid())
  rule_key    String   @unique
  rule_value  String
  description String
  is_active   Boolean  @default(true)
  updated_at  DateTime @updatedAt
}
