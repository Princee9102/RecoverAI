PORT=5000
DATABASE_URL="file:./dev.db"

# Optional: Add your OpenAI API key for live GPT structured outputs
# If omitted or empty, RecoverAI automatically uses DemoAIService (Deterministic AI Engine)
OPENAI_API_KEY=

# Optional: Add Razorpay Test Mode credentials
# If omitted or empty, RecoverAI automatically uses MockPaymentGateway (Sandbox Simulation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

NODE_ENV=development
